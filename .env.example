# UNN E-Library — example configuration only.
# Copy to .env and replace values locally. NEVER commit .env.

# PostgreSQL database connection (use your own credentials)
DATABASE_URL=postgresql+psycopg2://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME
# Optional: separate database for tests
# TEST_DATABASE_URL=postgresql+psycopg2://YOUR_TEST_USER:YOUR_TEST_PASSWORD@localhost:5432/YOUR_TEST_DB

# Generate a fresh, long, random JWT secret for each environment
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase project settings — private storage bucket access
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVER_KEY

# Legacy/optional SMTP settings (only if your email service uses SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# If your LOCAL Resend email implementation reads other environment
# variables (for example an API key or sender address), add their
# variable NAMES here with placeholder values — never the real values.
